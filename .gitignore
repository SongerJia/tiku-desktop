# 依赖（原生模块 better-sqlite3 不能入库，每台机器本地编译）
node_modules/

# 构建产物
dist/
dist-electron/
dist-mobile/
release/
out/

# Vditor 离线资源必须入库（发布版依赖 ./vditor 加载；dist/ 规则会误匹配 public/vditor/dist，显式放行）
!public/vditor/dist/

# 本地数据库（含你刷过的题、记录，不应入库）
*.db
*.sqlite
*.sqlite3

# 日志
*.log
npm-debug.log*

# 环境变量 / 密钥
.env
.env.*

# 编辑器 / 系统
.DS_Store
.vscode/
.idea/
*.swp

# xlsx 测试夹具（可由 scripts/make-fixture-xlsx.py 重新生成）
*.xlsx

# 测试运行时的临时产物
.tmp-*
tmp*
dist.bak/
dist.bak2/
scripts/__*

# 测试输出
db-test-out.txt
sqljs-test-out.txt
mobile-boot-test-out.txt
mobile-dist-test-out.txt
db-error.txt
sqljs-error.txt

# 手动下载的包（沙箱内 npm install 不可用时 curl 下载，解压后残留）
pako.tgz
mobile-nofs-test-out.txt

# Android 签名密钥（本地生成，绝不入库；CI 由 ANDROID_KEYSTORE_BASE64 解码还原）
android/release-keystore.jks
android/*.jks
