# 依赖（原生模块 better-sqlite3 不能入库，每台机器本地编译）
node_modules/

# 构建产物
dist/
dist-electron/
release/
out/

# 本地数据库（含你刷过的题、记录，不应入库）
*.db
*.sqlite
*.sqlite3

# 日志
*.log
npm-debug.log*

# 环境变量 / 密钥
.env
.env.*

# 编辑器 / 系统
.DS_Store
.vscode/
.idea/
*.swp

# xlsx 测试夹具（可由 scripts/make-fixture-xlsx.py 重新生成）
*.xlsx

# 测试运行时的临时产物
.tmp-*
tmp*
dist.bak/
dist.bak2/
scripts/__*
