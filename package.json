{
  "name": "tiku-desktop",
  "version": "0.1.0",
  "description": "本地优先刷题题库桌面客户端（Electron + Vue3 + SQLite），考证题库 MVP",
  "main": "electron/main.js",
  "author": "zhang",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "test:parser": "node scripts/test-parser.mjs",
    "test:xlsx": "node scripts/test-xlsx.mjs",
    "test:kb": "python scripts/test-kb.py && node scripts/test-kb-extract.mjs",
    "verify": "vite build --config vite.verify.config.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "pdfjs-dist": "^6.2.108",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^31.0.0",
    "electron-rebuild": "^3.1.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
