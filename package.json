{
  "name": "tiku-desktop",
  "productName": "知识记忆小助手",
  "version": "0.6.0",
  "description": "本地优先刷题 + 知识库 all-in-one 学习工具（Electron + Vue3 + SQLite）",
  "main": "electron/main.js",
  "author": "zhang",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "test:parser": "node scripts/test-parser.mjs",
    "test:xlsx": "node scripts/test-xlsx.mjs",
    "test:kb": "python scripts/test-kb.py && node scripts/test-kb-extract.mjs",
    "test:sync": "node scripts/test-sync-merge.mjs",
    "verify": "vite build --config vite.verify.config.js",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.songerjia.tiku",
    "productName": "知识记忆小助手",
    "directories": { "output": "release" },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "知识记忆小助手"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "markdown-it": "^15.0.0",
    "pdfjs-dist": "^6.2.108",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.1.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
