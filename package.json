{
  "name": "tiku-desktop",
  "productName": "知识记忆小助手",
  "version": "0.8.0",
  "description": "本地优先刷题 + 知识库 all-in-one 学习工具（Electron + Vue3 + SQLite）",
  "main": "electron/main.js",
  "author": "zhang",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "test:parser": "node scripts/test-parser.mjs",
    "test:xlsx": "node scripts/test-xlsx.mjs",
    "test:kb": "python scripts/test-kb.py && node scripts/test-kb-extract.mjs",
    "test:sync": "node scripts/test-sync-merge.mjs",
    "test:db": "electron scripts/test-db.cjs",
    "test:mobile": "node scripts/test-mobile-boot.cjs && vite build --config vite.mobile.config.js && node scripts/test-mobile-dist.cjs",
    "test:mobile:nofs": "node scripts/test-mobile-nofs.cjs",
    "build:mobile": "vite build --config vite.mobile.config.js",
    "sim:mobile": "electron scripts/mobile-sim.cjs",
    "sim:mobile:nodevtools": "electron scripts/mobile-sim.cjs --no-devtools",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "test": "node scripts/test-parser.mjs && node scripts/test-xlsx.mjs && node scripts/test-sync-merge.mjs && node scripts/test-sm2.mjs && node scripts/test-kb-extract.mjs",
    "verify": "vite build --config vite.verify.config.js",
    "dist": "vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder",
    "release": "node scripts/check-release-version.mjs && vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --publish always",
    "bump": "node scripts/bump-version.mjs"
  },
  "build": {
    "appId": "com.songerjia.tiku-desktop",
    "productName": "知识记忆小助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "知识记忆小助手"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "songerjia",
        "repo": "tiku-desktop",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "artifactName": "tiku-desktop-setup-${version}.${ext}"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@floating-ui/dom": "^1.8.0",
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.8.9",
    "pako": "^2.1.0",
    "pdfjs-dist": "^6.2.108",
    "sql.js": "^1.14.1",
    "vditor": "^3.11.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.1.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue": "^3.4.0"
  },
  "homepage": "https://github.com/songerjia/tiku-desktop"
}
